{
  "name": "the-interview-alchemist-monorepo",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend/the-interview-alchemist",
    "build": "npm run build --prefix frontend/the-interview-alchemist",
